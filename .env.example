# Copy to `.env` / `.env.local` and edit. NEVER commit real secrets here (frontend env is public by design).
# Frontend `lib/config.ts` এই key-গুলো পড়ে — পরে port/URL বদলাতে শুধু env বদলাও।

# ---- Frontend (Next.js) ----
# কোন port-এ run হবে
PORT=3020
NEXT_PUBLIC_PORT=3020
# Frontend নিজের URL
NEXT_PUBLIC_APP_URL=http://localhost:3020

# ---- Backend (Express API) ----
# Backend port (reference)
NEXT_PUBLIC_BACKEND_PORT=4000
# Frontend -> Backend সব API call এই URL থেকে তৈরি হয়। দুটো form-ই চলবে:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000
