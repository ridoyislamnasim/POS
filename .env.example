# Copy to `.env` / `.env.local` and edit. NEVER commit real secrets here.
# Only PUBLIC config may use NEXT_PUBLIC_* (API base URL + env name).
# NEVER put JWT secrets, DB credentials, or private API keys in NEXT_PUBLIC_*.
#
# Frontend `lib/config.ts` reads exactly these two keys (both REQUIRED):
#   NEXT_PUBLIC_APP_ENV : local | production
#   NEXT_PUBLIC_API_URL : backend origin (origin form — no trailing /api)
#
# Local:
#   NEXT_PUBLIC_APP_ENV=local
#   NEXT_PUBLIC_API_URL=http://localhost:4000
# Production (set in hosting env dashboard BEFORE `npm run build`; never rely on .env.local):
#   NEXT_PUBLIC_APP_ENV=production
#   NEXT_PUBLIC_API_URL=https://server.shohojhisab.com
#
# Priority: real env vars > .env.local > .env. Missing/invalid values FAIL the
# dev server / build with a clear [api-config] error (no silent localhost fallback).
# After ANY change: restart `npm run dev` (values are embedded at start/build).
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- CI/CD ----
# In GitHub Actions, NEXT_PUBLIC_APP_ENV=production and
# NEXT_PUBLIC_API_URL=https://server.shohojhisab.com are set automatically
# in the CI workflow. For local CI testing, copy .env.example to .env.local.
